{
  "description": "Reports the session's state to the ionterm pane it runs in",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$IONTERM_SOCKET\" ] || \"${IONTERM_BIN:-ionterm}\" claude-hook 2>/dev/null; exit 0",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$IONTERM_SOCKET\" ] || \"${IONTERM_BIN:-ionterm}\" claude-hook 2>/dev/null; exit 0",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
