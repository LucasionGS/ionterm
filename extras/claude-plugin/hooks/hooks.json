            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$IONTERM_SOCKET\" ] || \"${IONTERM_BIN:-ionterm}\" claude-hook 2>/dev/null; exit 0",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
